{
  "Monitoring": {
    "ScreenshotIntervalSeconds": 300,
    "ProcessIntervalSeconds": 60,
    "RetentionHours": 24
  },
  "Storage": {
    "RootPath": "%LOCALAPPDATA%\\Xugar\\EndpointMonitor\\Data"
  },
  "ServerSync": {
    "Enabled": false,
    "BaseUrl": "http://localhost:3000",
    "AllowInsecureLocalhost": true,
    "EnrollmentToken": "",
    "HeartbeatIntervalSeconds": 60,
    "PolicyRefreshIntervalSeconds": 300,
    "PolicyMaxAgeSeconds": 900,
    "UploadBatchSize": 100,
    "QueueMaxItems": 1000,
    "QueueMaxBytes": 104857600,
    "QueueMaxAgeHours": 168,
    "RequestTimeoutSeconds": 30,
    "RetryMinimumSeconds": 5,
    "RetryMaximumSeconds": 300
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  }
}
