# PostgreSQL development connection. Change the development password before use.
DATABASE_URL=postgresql://xugar_dev:xugar_dev_only_change_me@127.0.0.1:55432/xugar_endpoint

# Enrollment bearer token. Generate a long random value; never commit the real token.
XUGAR_ENROLLMENT_TOKEN=

# Private screenshot storage outside server/public.
XUGAR_SCREENSHOT_STORAGE_ROOT=C:\ProgramData\Xugar\EndpointServer\Screenshots
XUGAR_SCREENSHOT_RETENTION_DAYS=7
XUGAR_SCREENSHOT_MAX_BYTES=10485760
XUGAR_DEVICE_OFFLINE_MINUTES=5

# disabled (safe default), development (local only), or google.
XUGAR_MANAGER_AUTH_MODE=disabled
XUGAR_DEVELOPMENT_MANAGER=false
XUGAR_MANAGER_GOOGLE_CLIENT_ID=
XUGAR_MANAGER_GOOGLE_CLIENT_SECRET=
XUGAR_MANAGER_ALLOWED_DOMAIN=
XUGAR_MANAGER_ALLOWED_EMAILS=
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# Phase 2A stores configuration only. Webhook/live ingestion begins in Phase 2C.
ACTIVTRAK_MODE=disabled
ACTIVTRAK_WEBHOOK_TOKEN=
ACTIVTRAK_ACTIVCONNECT_ENABLED=false
ACTIVTRAK_LIVE_API_BASE_URL=
ACTIVTRAK_CREDENTIAL_REFERENCE=
